.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- os / editors ---
.DS_Store
.idea/
.vscode/
*.swp
